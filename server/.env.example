# ---------------------------------------------------------------
# UNIGO - Configuration du serveur
# Copiez ce fichier en ".env" puis adaptez les valeurs.
# ---------------------------------------------------------------

# Base de donnees MySQL (XAMPP)
# Par defaut avec XAMPP : utilisateur "root", mot de passe vide, port 3306.
# Creez d'abord la base "unigo" dans phpMyAdmin (http://localhost/phpmyadmin).
DATABASE_URL="mysql://root:@localhost:3306/unigo"

# Serveur
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Securite / JWT
# IMPORTANT : remplacez cette valeur par une chaine longue et aleatoire en production.
JWT_SECRET="changez-moi-avec-une-longue-chaine-aleatoire-unigo-2026"
JWT_EXPIRES_IN="7d"

# Duree de validite du lien de reinitialisation de mot de passe (minutes)
RESET_TOKEN_TTL_MINUTES=30

# Envoi d'e-mails (reinitialisation de mot de passe)
# Laissez MAIL_ENABLED=false en developpement : le lien de reinitialisation
# s'affiche alors directement dans la console du serveur.
MAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="UNIGO <no-reply@unigo.sn>"

# Compte administrateur cree par le seed
ADMIN_EMAIL="admin@unigo.sn"
ADMIN_PASSWORD="Admin1234!"
