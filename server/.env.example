# ---------------------------------------------------------------
# UNIGO — Réglages du serveur
# Copie ce fichier en « .env » (sans le .example) et adapte si besoin.
# ---------------------------------------------------------------

# --- Base de données MySQL (XAMPP) ---
# Les valeurs ci-dessous sont celles de XAMPP par défaut :
# utilisateur "root", aucun mot de passe, port 3306.
# La base "unigo" et ses tables sont créées automatiquement au démarrage.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unigo

# --- Serveur ---
PORT=4000

# --- Sécurité ---
# Sert à signer les jetons de connexion.
# En production : remplace par une longue chaîne aléatoire.
JWT_SECRET=unigo-cle-de-developpement-a-changer
